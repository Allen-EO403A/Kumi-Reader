{
    "interface_version": 2,
    "name": "Kumi 讀取程式",
    "description": "讀取「忍者必須死」的家族成員與深淵排行，上傳到 Kumi（SS+ 管理系統）。",
    "version": "0.4.1",
    "welcome": "使用說明.md",
    "controller": [
        {
            "name": "雷電模擬器（ADB）",
            "type": "Adb",
            "display_raw": true
        }
    ],
    "resource": [
        {
            "name": "預設",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "./python/python.exe",
        "child_args": [
            "-u",
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "設定金鑰（從剪貼簿）",
            "entry": "SetKey",
            "option": [
                "ApiUrl"
            ],
            "description": "第一次使用或換金鑰時執行：先在網站「讀取程式金鑰」頁產生金鑰並按「複製」，再執行這個任務。金鑰會寫進本機設定並清除剪貼簿，不會出現在紀錄檔。"
        },
        {
            "name": "讀取家族成員",
            "entry": "ReadMembers",
            "option": [
                "ExpectedCount",
                "DiscardLocal"
            ],
            "description": "打開家族面板的「成員」分頁後執行。程式會先滑到名單最上面，逐一讀取每位成員，讀到底時核對人數。結果存在本機，要再執行「上傳讀取結果」。"
        },
        {
            "name": "補讀缺少的成員",
            "entry": "ReadMissingMembers",
            "option": [
                "ExpectedCount"
            ],
            "description": "人數對不上時使用：打開「成員」分頁後執行（停在哪一頁都可以）。程式會從最上面一路滑到底，只讀還沒讀過的成員。"
        },
        {
            "name": "讀取深淵排行",
            "entry": "ReadAbyss",
            "description": "請在週五 21:00 深淵結束後、下一個週五 20:00（排行清空）前執行。打開深淵排行榜的「家族狀況」分頁後執行；程式只滑動、不點擊。結果存在本機，要再執行「上傳讀取結果」。"
        },
        {
            "name": "上傳讀取結果",
            "entry": "Upload",
            "description": "把本機還沒上傳的家族成員與深淵排行結果上傳到 Kumi。上傳失敗時結果會保留，稍後再執行即可，不用重新讀取。"
        }
    ],
    "option": {
        "ExpectedCount": {
            "type": "input",
            "label": "家族成員數（選填）",
            "description": "留空時讀取畫面上的「成員：N/100」。有填寫時以這個數字核對，與畫面上的數字不同會提醒。",
            "inputs": [
                {
                    "name": "ExpectedCount",
                    "label": "成員數",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\\d*$"
                }
            ],
            "pipeline_override": {
                "ReadMembers": {
                    "custom_action_param": {
                        "expectedCount": "{ExpectedCount}"
                    }
                },
                "ReadMissingMembers": {
                    "custom_action_param": {
                        "expectedCount": "{ExpectedCount}"
                    }
                }
            }
        },
        "DiscardLocal": {
            "type": "switch",
            "label": "捨棄本機結果重新讀取",
            "description": "本機還有沒上傳的家族成員結果時，讀取會停下來提醒。確定不要那份結果時才設為「是」。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "是",
                    "pipeline_override": {
                        "ReadMembers": {
                            "custom_action": "ReadMembersDiscard"
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "否",
                    "pipeline_override": {
                        "ReadMembers": {
                            "custom_action": "ReadMembers"
                        }
                    }
                }
            ]
        },
        "ApiUrl": {
            "type": "input",
            "label": "後端網址（選填）",
            "description": "第一次設定時填寫，例如 https://api.kumi.example.org。之後留空會沿用原本的網址。",
            "inputs": [
                {
                    "name": "ApiUrl",
                    "label": "後端網址",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^(|https?://\\S+)$"
                }
            ],
            "pipeline_override": {
                "SetKey": {
                    "custom_action_param": {
                        "apiUrl": "{ApiUrl}"
                    }
                }
            }
        }
    }
}
