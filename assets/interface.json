{
    "interface_version": 2,
    "name": "Kumi 讀取程式",
    "description": "讀取「忍者必須死3」的家族成員與深淵排行，上傳到 Kumi（SS+ 管理系統）。",
    "version": "0.1.1",
    "controller": [
        {
            "name": "雷電模擬器（ADB）",
            "type": "Adb",
            "display_raw": true
        }
    ],
    "resource": [
        {
            "name": "預設",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "./python/python.exe",
        "child_args": [
            "-u",
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "設定金鑰（從剪貼簿）",
            "entry": "SetKey",
            "option": [
                "ApiUrl"
            ],
            "description": "第一次使用或換金鑰時執行：先在網站「讀取程式金鑰」頁產生金鑰並按「複製」，再執行這個任務。金鑰會寫進本機設定並清除剪貼簿，不會出現在紀錄檔。"
        },
        {
            "name": "讀取家族成員",
            "entry": "ReadMembers",
            "option": [
                "ExpectedCount"
            ],
            "description": "打開家族面板的「成員」分頁後執行。程式會先滑到名單最上面，逐一讀取每位成員；讀到底時核對人數。"
        },
        {
            "name": "補讀目前畫面",
            "entry": "ReadMembersPage",
            "option": [
                "ExpectedCount"
            ],
            "description": "人數對不上時使用：把名單移到缺少成員所在的那一頁後執行，只讀這一頁還沒讀過的成員，並上傳到同一批次。"
        },
        {
            "name": "讀取深淵排行",
            "entry": "ReadAbyss",
            "description": "請在週五 21:00 深淵結束後、排行清空前執行。打開深淵排行榜的「家族狀況」分頁後執行；程式只滑動、不點擊。"
        }
    ],
    "option": {
        "ExpectedCount": {
            "type": "input",
            "label": "家族成員數（選填）",
            "description": "留空時讀取畫面上的「成員：N/100」。有填寫時以這個數字核對，與畫面上的數字不同會提醒。",
            "inputs": [
                {
                    "name": "ExpectedCount",
                    "label": "成員數",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^\\d*$"
                }
            ],
            "pipeline_override": {
                "ReadMembers": {
                    "custom_action_param": {
                        "expectedCount": "{ExpectedCount}"
                    }
                },
                "ReadMembersPage": {
                    "custom_action_param": {
                        "expectedCount": "{ExpectedCount}"
                    }
                }
            }
        },
        "ApiUrl": {
            "type": "input",
            "label": "後端網址（選填）",
            "description": "第一次設定時填寫，例如 https://api.kumi.example.org。之後留空會沿用原本的網址。",
            "inputs": [
                {
                    "name": "ApiUrl",
                    "label": "後端網址",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^(|https?://\\S+)$"
                }
            ],
            "pipeline_override": {
                "SetKey": {
                    "custom_action_param": {
                        "apiUrl": "{ApiUrl}"
                    }
                }
            }
        }
    }
}